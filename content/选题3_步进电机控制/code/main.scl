// ==========================================
// 1. 电机上电使能
// ==========================================
"轴使能_DB"(
         Axis := "步进电机", 
         Enable := NOT "停止按钮",
         StartMode := 1,
         StopMode := 0
);

// ==========================================
// 2. 步进电机回原点
// ==========================================
// 设置
"回原点_DB"(
         Axis := "步进电机",
         Execute := "回原点启动",
         Position := 0.0,
         Mode := 0
);
// 回
"绝对定位_DB"(
          Axis := "步进电机",
          Execute := "回原点",
          Position :=0.0,
          Velocity := "自动运行速度"
);

// ==========================================
// 3. 手动模式：点动控制
// ==========================================
"点动_DB"(
        Axis := "步进电机",
        JogForward := "点动正转" ,
        JogBackward := "点动反转" ,
        Velocity := "点动速度"
);



// ==========================================
// 4. 自动模式：顺序控制逻辑
// ==========================================
// 启动条件：自动模式 且 按下定位启动 且 状态机处于待机
IF "手动自动切换" AND ("自动状态" = 0) THEN
    "自动状态" := 1;
END_IF;

// 停止逻辑
IF "停止按钮" THEN
    "自动状态" := 0;
    "轴停止_DB"(Axis := "步进电机",
             Execute := TRUE);
ELSE
    "轴停止_DB"(Axis := "步进电机",
             Execute := FALSE);
END_IF;


// --- 状态机流转 (A -> B -> C -> B) ---
CASE "自动状态" OF
    1: // 从 A 运动到 B
        "绝对定位_DB"(
                  Axis := "步进电机",
                  Execute := TRUE,
                  Position := "B点坐标",
                  Velocity := "自动运行速度"
        );
        IF "绝对定位_DB".Done THEN
            "绝对定位_DB"(Axis := "步进电机",
                      Execute := FALSE);
            "自动状态" := 2;
        END_IF;
        
    2: // 在 B 点停留 2 秒，取货灯亮
        "B点延时_DB".TON (IN := TRUE,
        PT := T#2S);
IF "B点延时_DB".Q THEN
            "B点延时_DB".TON (IN := FALSE,
                           PT := T#2S); // 复位定时器
            "自动状态" := 3;
        END_IF;
        
    3: // 从 B 运动到 C
        "绝对定位_DB"(
                  Axis := "步进电机",
                  Execute := TRUE,
                  Position := "C点坐标",
                  Velocity := "自动运行速度"
        );
        IF "绝对定位_DB".Done THEN
            "绝对定位_DB"(Axis := "步进电机",
                      Execute := FALSE);
            "自动状态" := 4;
        END_IF;
        
    4: // 在 C 点停留 2 秒，放货灯亮
        "C点延时_DB".TON (IN := TRUE,
        PT := T#2S);
IF "C点延时_DB".Q THEN
            "C点延时_DB".TON (IN := FALSE,
                           PT := T#2S);
            "自动状态" := 5;
        END_IF;
        
    5: // 返回原点 B
        "绝对定位_DB"(
                  Axis := "步进电机",
                  Execute := TRUE,
                  Position := "B点坐标",
                  Velocity := "自动运行速度"
        );
        IF "绝对定位_DB".Done THEN
            "绝对定位_DB"(Axis := "步进电机",
                      Execute := FALSE);
            
            IF "循环" THEN
                "自动状态" := 2; // 流程结束
            ELSE
                "自动状态" := 0; // 流程结束
            END_IF;
        END_IF;
END_CASE;


